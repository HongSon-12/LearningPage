generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Setting {
  id                 Int      @id @default(1)
  bankName           String
  accountName        String
  accountNumber      String
  transferSyntax     String
  googleAnalyticsId  String?
  facebookPixelId    String?
  microsoftClarityId String?
  updatedAt          DateTime @updatedAt
}

enum CourseType {
  COMMUNITY_FIRST_AID
  CME_ABCDE
  AMBULANCE_DRIVER
  CPR_ADVANCED
  CPR_BASIC
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClassStatus {
  OPEN
  FULL
  DONE
}

model Class {
  id            String         @id @default(uuid())
  courseType    CourseType     @default(COMMUNITY_FIRST_AID)
  code          String         @unique
  name          String
  date          DateTime
  startTime     String
  endTime       String
  capacity      Int            @default(40)
  status        ClassStatus    @default(OPEN)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  registrations Registration[]
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

model Registration {
  id                String             @id @default(uuid())
  classId           String
  class             Class              @relation(fields: [classId], references: [id])
  fullName          String
  dob               DateTime
  phone             String
  email             String?
  organization      String?
  printOrgOnCert    Boolean            @default(false)
  cccd              String?            // CME required
  workplace         String?            // CME required
  idPhotoUrl        String?            // Upload path for CCCD/ID
  degreeUrl         String?            // Upload path for professional degree
  paymentReceiptUrl String?            // Upload path for transfer receipt
  note              String?
  paymentStatus     PaymentStatus      @default(PENDING)
  status            RegistrationStatus @default(PENDING)
  invoiceCode       String?            // HĐĐT tracking code
  certificateCode   String?            // CME certificate number
  source            String?
  sessionId         String?
  createdAt         DateTime           @default(now())
}

model TrackingEvent {
  id        String   @id @default(uuid())
  sessionId String
  source    String?
  eventName String
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([eventName])
}
