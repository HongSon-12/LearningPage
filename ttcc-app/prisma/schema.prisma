generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Setting {
  id                 Int      @id @default(1)
  bankName           String
  accountName        String
  accountNumber      String
  transferSyntax     String
  googleAnalyticsId  String?
  facebookPixelId    String?
  microsoftClarityId String?
  updatedAt          DateTime @updatedAt
}

enum ClassStatus {
  OPEN
  FULL
  DONE
}

model Class {
  id            String         @id @default(uuid())
  code          String         @unique
  name          String
  date          DateTime
  startTime     String
  endTime       String
  capacity      Int            @default(40)
  status        ClassStatus    @default(OPEN)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  registrations Registration[]
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

model Registration {
  id             String        @id @default(uuid())
  classId        String
  class          Class         @relation(fields: [classId], references: [id])
  fullName       String
  dob            DateTime
  phone          String
  email          String?
  organization   String?
  printOrgOnCert Boolean       @default(false)
  note           String?
  paymentStatus  PaymentStatus @default(PENDING)
  source         String?
  sessionId      String?
  createdAt      DateTime      @default(now())
}

model TrackingEvent {
  id        String   @id @default(uuid())
  sessionId String
  source    String?
  eventName String
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([eventName])
}
