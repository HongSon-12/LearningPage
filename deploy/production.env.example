# Điền các giá trị REPLACE_WITH... trước khi khởi chạy trên máy chủ.
# Nếu bí mật có ký tự $, bao giá trị trong nháy đơn. URL-encode mật khẩu trong URL database.
# Copy to .env.production on the server, chmod 600; never commit real values.
NODE_ENV=production
TRUST_PROXY=true
PRIVATE_UPLOAD_DIR=/data/uploads

PG_HOST=cap-cuu-115-db
PG_PORT=5432
DB_NETWORK=cap-cuu-115_private
PROXY_NETWORK=cap-cuu-115_private

# Existing PostgreSQL 16 Alpine, with a dedicated database and application role.
# Generate passwords/secret separately for production.
# URL-encode reserved characters in the password. Do not use localhost inside Docker.
DATABASE_URL=postgresql://edu_user:REPLACE_WITH_RANDOM_PASSWORD@${PG_HOST}:${PG_PORT}/edu?schema=public
# Empty: migrations use edu_user from DATABASE_URL. Fill only if DBA supplies a separate migration role for edu.
MIGRATION_DATABASE_URL=
DATABASE_POOL_MAX=10
APP_ORIGIN=https://edu.115.org.vn
LOOKUP_OTP_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
SMTP_HOST=pro66.emailserver.vn
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=edu@115.org.vn
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
# Rebuild locally after code updates; latest is a mutable tag, not an automatic update.
RELEASE_TAG=latest

# App listens on container port 13081, fixed by docker-compose.production.yml. No host port is published.
# Map existing AUTHENTIK_* credentials to SSO_* names below; code does not read AUTHENTIK_*.
# Verify credentials belong to provider edu; the old .env issuer /application/o/app115/ must not be reused blindly.
# Central authentication. Secrets are set privately on the server.
# Provider scopes: openid profile email offline_access (refresh token required).
# No 5-minute idle lock; app session max 8h, short-lived access tokens renew server-side.
# Callback: https://edu.115.org.vn/api/auth/callback/authentik
# Logout return: https://edu.115.org.vn/da-dang-xuat
# Back-channel: https://edu.115.org.vn/api/auth/backchannel-logout
# Webhook: https://edu.115.org.vn/api/auth/webhook/authentik
AUTH_MODE=sso
SSO_ISSUER=https://sso.115.org.vn/application/o/edu/
SSO_CLIENT_ID=y2FhSDe4EM0VbaSKtfCrniWkhHjJNuZECUxSa2XO
SSO_CLIENT_SECRET=REPLACE_WITH_OIDC_CLIENT_SECRET
# Separate 32 random bytes in hex; encrypts server-side access/ID tokens.
SSO_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
# Service-account API token: read all human users and events only; not the webhook Bearer.
SSO_API_TOKEN=REPLACE_WITH_READ_ONLY_SSO_API_TOKEN
# Exactly the secret after "Bearer " in the SSO transport header mapping.
SSO_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_BEARER_SECRET
