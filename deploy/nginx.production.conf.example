# BEGIN LEARNINGPAGE EDU
# Append once to the existing /etc/nginx/conf.d/default.conf (http context).
# Dedicated virtual host; retain all existing server blocks for other domains.
# Existing proxy container and app share cap-cuu-115_private.
# Runtime Docker DNS follows app IP changes and permits nginx -t before edu exists.
# Certificate paths match the current proxy mounts; verify coverage for edu.115.org.vn.
# If using a CDN, configure real_ip from ONLY its trusted IP ranges first.
limit_req_zone $binary_remote_addr zone=learning_lookup:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=learning_upload:10m rate=20r/m;

server {
    listen 80;
    server_name edu.115.org.vn;
    access_log off;
    return 301 https://edu.115.org.vn$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name edu.115.org.vn;
    ssl_certificate /etc/letsencrypt/live/_.115.org.vn/fullchain.crt;
    ssl_certificate_key /etc/letsencrypt/live/_.115.org.vn/privatekey.key;
    # Callback/logout query strings can contain temporary credentials.
    access_log off;

    # Resolve at request time; do not add edu to the existing nextjs_upstream.
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;
    set $learning_edu_backend http://edu-app:13081;

    proxy_http_version 1.1;
    proxy_cache off;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;

    # Application accepts files <= 5 MiB; leave room for multipart metadata.
    client_max_body_size 6m;
    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location ^~ /uploads/ { return 404; }
    # Readiness is for internal monitoring only.
    location ^~ /api/health/ { return 404; }

    location = /search {
        limit_req zone=learning_lookup burst=10 nodelay;
        limit_req_status 429;
        proxy_pass $learning_edu_backend;
        proxy_set_header Connection "";
        proxy_set_header Host edu.115.org.vn;
        proxy_set_header X-Forwarded-Host edu.115.org.vn;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Forwarded "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
    }
    location = /api/upload {
        limit_req zone=learning_upload burst=5 nodelay;
        limit_req_status 429;
        proxy_pass $learning_edu_backend;
        proxy_set_header Connection "";
        proxy_set_header Host edu.115.org.vn;
        proxy_set_header X-Forwarded-Host edu.115.org.vn;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Forwarded "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location / {
        proxy_pass $learning_edu_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host edu.115.org.vn;
        proxy_set_header X-Forwarded-Host edu.115.org.vn;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Forwarded "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 60s;
    }
}
# END LEARNINGPAGE EDU
