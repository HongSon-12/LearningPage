# Copy to .env for pnpm dev or the LOCAL Compose stack. Do not use in production.
AUTH_MODE=local
DATABASE_URL=postgresql://ttcc_user:ttcc_password@localhost:5432/ttcc_db?schema=public
APP_ORIGIN=http://localhost:3001
LOOKUP_OTP_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
# Container Nginx -> local app; keep these two values consistent when changing its port.
LOCAL_HTTP_PORT=80
LOCAL_APP_ORIGIN=http://localhost
