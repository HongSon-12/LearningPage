generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  role         UserRole @default(ADMIN)
  active       Boolean @default(true)
  sessions     Session[]
  managedClasses Class[] @relation("ClassManager")
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum UserRole {
  ADMIN
  CLASS_MANAGER
  ACCOUNTANT
}

model Session {
  tokenHash String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([userId])
}

model LoginAttempt {
  key String @id
  failures Int @default(0)
  blockedUntil DateTime?
}

enum RegistrationMethod {
  ONLINE
  MANUAL
  LATE
}

model RegistrationEvent {
  id String @id @default(uuid())
  registrationId String
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  actorId String
  action String
  details Json
  createdAt DateTime @default(now())
  @@index([registrationId])
}

model Setting {
  id                 Int      @id @default(1)
  bankName           String
  accountName        String
  accountNumber      String
  transferSyntax     String
  googleAnalyticsId  String?
  facebookPixelId    String?
  microsoftClarityId String?
  updatedAt          DateTime @updatedAt
}

enum CourseType {
  COMMUNITY_FIRST_AID
  CME_ABCDE
  AMBULANCE_DRIVER
  CPR_ADVANCED
  CPR_BASIC
}

enum TargetAudience {
  DOCTOR
  NURSE
  PHYSICIAN
  DRIVER
  COMMUNITY
}

enum CertificateType {
  CERTIFICATE
  CONFIRMATION
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClassStatus {
  OPEN
  FULL
  DONE
}

model Class {
  id                   String            @id @default(uuid())
  courseType           CourseType        @default(COMMUNITY_FIRST_AID)
  code                 String            @unique
  name                 String
  courseBatch          String?           // VD: Khóa 1, Khóa 2
  fee                  Float             @default(0) // Học phí
  location             String            @default("") // Địa điểm học
  startDate            DateTime          @default(now()) // Thời gian học (từ ngày)
  endDate              DateTime          @default(now()) // Thời gian học (đến ngày)
  startTime            String
  endTime              String
  registrationDeadline DateTime?         // Hạn đăng ký
  totalLessons         Int               @default(0) // Tổng số tiết
  targetAudiences      TargetAudience[]  // Đối tượng đăng ký
  certificateType      CertificateType   @default(CERTIFICATE) // Loại chứng chỉ
  capacity             Int               @default(40)
  status               ClassStatus       @default(OPEN)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  sessions             ClassSession[]
  registrations        Registration[]
  managerId            String?
  manager              User? @relation("ClassManager", fields: [managerId], references: [id])
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

model Registration {
  id                String             @id @default(uuid())
  studentId         String?
  student           Student? @relation(fields: [studentId], references: [id], onDelete: Restrict)
  profileReviewRequired Boolean @default(false)
  classId           String
  class             Class              @relation(fields: [classId], references: [id])
  fullName          String
  dob               DateTime
  gender            Gender?            // Giới tính
  phone             String
  email             String?
  organization      String?
  printOrgOnCert    Boolean            @default(false)
  cccd              String?            // CME required
  workplace         String?            // CME required
  idPhotoUrl        String?            // Upload path for CCCD/ID
  degreeUrl         String?            // Upload path for professional degree
  paymentReceiptUrl String?            // Upload path for transfer receipt
  note              String?
  paymentStatus     PaymentStatus      @default(PENDING)
  status            RegistrationStatus @default(PENDING)
  invoiceCode       String?            // HĐĐT tracking code
  certificateCode   String?            // CME certificate number
  registrationMethod RegistrationMethod @default(ONLINE)
  createdById String?
  requestKey String? @unique
  receiptTokenHash String?
  rejectionReason String?
  confirmationNumber String?
  certificateDeliveredDirect Boolean @default(false)
  certificateSentByPost Boolean @default(false)
  idPhotoFileId String? @unique
  idPhotoFile StoredFile? @relation("IdentityFile", fields: [idPhotoFileId], references: [id])
  degreeFileId String? @unique
  degreeFile StoredFile? @relation("DegreeFile", fields: [degreeFileId], references: [id])
  paymentReceiptFileId String? @unique
  paymentReceiptFile StoredFile? @relation("ReceiptFile", fields: [paymentReceiptFileId], references: [id])
  storedFiles StoredFile[] @relation("OwnedFiles")
  attendance Attendance[]
  searchTokens SearchToken[]
  emailJobs EmailOutbox[]
  events RegistrationEvent[]
  source            String?
  sessionId         String?
  createdAt         DateTime           @default(now())
  @@index([classId, status, paymentStatus])
  @@index([cccd, createdAt])
  @@index([studentId, createdAt])
}

model TrackingEvent {
  id        String   @id @default(uuid())
  sessionId String
  source    String?
  eventName String
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([eventName])
}


enum FileKind {
  ID_PHOTO
  DEGREE
  RECEIPT
}

model StoredFile {
  id String @id @default(uuid())
  storageKey String @unique
  kind FileKind
  mime String
  size Int
  sha256 String
  scanStatus String @default("UNVERIFIED")
  classId String
  uploadedById String?
  ownerTokenHash String?
  registrationId String?
  registration Registration? @relation("OwnedFiles", fields: [registrationId], references: [id], onDelete: SetNull)
  identityFor Registration? @relation("IdentityFile")
  degreeFor Registration? @relation("DegreeFile")
  receiptFor Registration? @relation("ReceiptFile")
  createdAt DateTime @default(now())
  @@index([registrationId])
  @@index([ownerTokenHash, createdAt])
  @@index([uploadedById, createdAt])
}

model AuditLog {
  id String @id @default(uuid())
  actorId String?
  action String
  resourceId String?
  result String
  createdAt DateTime @default(now())
  @@index([action, createdAt])
}

model RateLimit {
  key String @id
  count Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}

model SearchToken {
  tokenHash String @id
  registrationId String
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  jobId String @unique
  expiresAt DateTime
  usedAt DateTime?
  @@index([expiresAt])
}

model EmailOutbox {
  id String @id @default(uuid())
  type String @default("SEARCH_OTP")
  challengeId String? @unique
  challenge LookupChallenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  registrationId String?
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  studentId String?
  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recipient String
  idempotencyKey String @unique
  status String @default("PENDING")
  attemptCount Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseId String?
  leaseUntil DateTime?
  lastErrorCode String?
  createdAt DateTime @default(now())
  sentAt DateTime?
  @@index([status, nextAttemptAt])
}


model LookupChallenge {
  id String @id @default(uuid())
  studentId String
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  identityHash String
  emailHash String
  codeHash String?
  expiresAt DateTime?
  failedAttempts Int @default(0)
  usedAt DateTime?
  createdAt DateTime @default(now())
  emailJob EmailOutbox?
  @@index([identityHash, createdAt])
}

model Student {
  id String @id @default(uuid())
  cccd String? @unique
  fullName String
  dob DateTime
  phone String
  email String?
  needsReview Boolean @default(true)
  registrations Registration[]
  lookupChallenges LookupChallenge[]
  emailJobs EmailOutbox[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([fullName, id])
}

model ClassSession {
  id String @id @default(uuid())
  classId String
  class Class @relation(fields: [classId], references: [id], onDelete: Restrict)
  title String
  startsAt DateTime
  endsAt DateTime
  location String @default("")
  closed Boolean @default(false)
  createdById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  attendance Attendance[]
  @@unique([classId, startsAt])
}

enum AttendanceMethod {
  QR
  MANUAL
}

model Attendance {
  id String @id @default(uuid())
  sessionId String
  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  registrationId String
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  present Boolean @default(true)
  method AttendanceMethod
  recordedById String
  recordedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([sessionId, registrationId])
  @@index([registrationId])
}
